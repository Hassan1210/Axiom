# Axiom OS — .gitignore

# Environment secrets (NEVER commit)
cloud/env/*.env
!cloud/env/*.env.example

# Logs (local only)
logs/*.log
logs/*.txt

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/
.npm/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.g.dart
*.freezed.dart

# Backup files
cloud/backups/*.sql.gz
cloud/backups/*.tar.gz
cloud/storage/large/

# IDE
.vscode/settings.json
.idea/
*.iml
