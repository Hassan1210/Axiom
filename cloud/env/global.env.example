# Axiom OS — Global Environment Template
# Copy this to global.env and fill in your values
# NEVER commit global.env to GitHub

# ─── Identity ───────────────────────────────────────
AXIOM_OWNER=Hassan
AXIOM_VERSION=1.0.0
AXIOM_ENV=production

# ─── Firebase ───────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=~/Documents/Axiom/axiom/cloud/env/firebase-service-account.json
FIREBASE_WEB_API_KEY=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ─── DigitalOcean ───────────────────────────────────
DO_API_TOKEN=dop_v1_xxxx
DO_DROPLET_ID=
DO_REGION=

# ─── GitHub ─────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxx
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxx
GITHUB_USERNAME=hassan210
GITHUB_ORG=

# ─── ERPNext / Frappe ───────────────────────────────
BENCH_PATH=/home/frappe/frappe-bench
FRAPPE_ADMIN_PASSWORD=
FRAPPE_DB_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=frappe
MYSQL_PASSWORD=

# ─── AI / LLM ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=sk-xxxx

# ─── Web Search MCPs ────────────────────────────────
BRAVE_API_KEY=BSA_xxxx
EXA_API_KEY=exa_xxxx
